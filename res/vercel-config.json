{
  "version": 3,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "cross-origin-opener-policy": "same-origin",
        "cross-origin-embedder-policy": "credentialless"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/assets/(.*)", "status": 404, "headers": { "cache-control": "no-store" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
